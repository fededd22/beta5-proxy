# --- Configuration du bot -----------------------------------------------------
# Option A : laisser ces deux variables vides et saisir l'ID admin + le token
# dans la page "/" du site après le déploiement (enregistrés une seule fois dans
# DATA_DIR/murad-bot.json ; nécessite un stockage persistant).
# Option B (recommandée sur Choreo, dont le disque est éphémère) : les définir
# dans les variables d'environnement / Configs & Secrets. La page de
# configuration est alors désactivée.
TELEGRAM_BOT_TOKEN=""
ADMIN_IDS=""

# Mot de passe de la page de configuration "/". CHANGEZ-LE : la valeur par
# défaut est visible dans le code source.
MURAD_SETUP_PASSWORD=""

# APP_URL: (optionnel) URL publique. Sinon le domaine est détecté automatiquement.
# Derrière une passerelle avec préfixe (Choreo), mettre l'URL COMPLÈTE, chemin
# inclus, ex. https://xxxx.choreoapis.dev/projet/composant/v1.0
APP_URL=""

# PORT: injecté par la plateforme si elle le fait. Défaut : 3000
# (doit correspondre à .choreo/component.yaml).
# EXTRA_PORTS: ports d'écoute supplémentaires (défaut : 8080,8000,5000,9090). Évite
#   l'erreur « delayed connect error: 111 » si le port de l'endpoint diffère de PORT.
# KEEP_ALIVE_INTERVAL: secondes entre deux pings automatiques (défaut : 30).
#   0 = keep-alive désactivé (Choreo : port 3000 => pas de scale-to-zero).
# DATA_DIR: dossier des données (scripts, config, libs). Défaut : /app/data ;
#   repli automatique sur un dossier temporaire s'il n'est pas inscriptible.

# --- Proxy (rotation automatique, voir proxymanager.py) ---
# PROXY_ENABLED=1            1 = passer par des proxys, 0 = connexion directe
# PROXY_ROTATE_INTERVAL=60   secondes entre deux changements de proxy
# PROXY_FALLBACK_DIRECT=1    1 = connexion directe si aucun proxy ne marche ; 0 = mode strict
# PROXY_LIST=                proxys fixes (ex: socks5://ip:port,http://ip:port) au lieu des listes publiques
# PROXY_SOURCES=             URLs de listes ip:port personnalisées
